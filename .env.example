# Base de Datos
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/datatutor
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=datatutor

# IA y Modelos
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=5m
CHAT_MODEL=qwen2.5:3b
EMBED_MODEL=bge-m3
EMBED_DIM=1024
NUM_CTX=4096
TEMPERATURE=0.0
NUM_PREDICT=512

# RAG
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4
SIM_THRESHOLD=0.65
SIM_LOW=0.50
MAX_UPLOAD_MB=30

# Autenticación
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_JWKS_URL=http://127.0.0.1:8080/realms/datatutor/protocol/openid-connect/certs
KEYCLOAK_REALM=datatutor
KEYCLOAK_CLIENT_ID=datatutor-web
KEYCLOAK_AUDIENCE=datatutor-web

# Frontend y CORS
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=datatutor
VITE_KEYCLOAK_CLIENT_ID=datatutor-web
VITE_MAX_UPLOAD_MB=30